{
  "expo": {
    "name": "FWWB Program",
    "slug": "fwwb-program-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E3192"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.fwwb.programapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Location is used to geotag attendance and form submissions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E3192"
      },
      "package": "org.fwwb.programapp",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "extra": {
      "apiUrl": "http://localhost:5000/api"
    }
  }
}
